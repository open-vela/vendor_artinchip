menuconfig AIC_LVGL_DEMO_APP
	bool "ArtInChip LVGL Demo App"
	default n
	depends on GRAPHICS_LVGL
	---help---
		Build the ArtInChip LVGL demo application (lv_demo).

if AIC_LVGL_DEMO_APP

choice
	prompt "AIC LVGL Demo"
	default AIC_LVGL_DASHBOARD_DEMO
	---help---
		Select which sub-application to build. Only one can be
		selected because each provides its own ui_init() entry.

config AIC_LVGL_DASHBOARD_DEMO
	bool "Dashboard Demo"
	---help---
		Build the dashboard demo: a speedometer-style instrument
		panel with arc gauge, signal indicators, and trip meter.

config AIC_LVGL_UI_BUILDER
	bool "UI Builder"
	---help---
		Build the UI generated by UIBuilder

endchoice

config AIC_LVGL_DEMO_PRIORITY
	int "lv_demo task priority"
	default 100

config AIC_LVGL_DEMO_STACKSIZE
	int "lv_demo stack size"
	default 40960

endif # AIC_LVGL_DEMO_APP
