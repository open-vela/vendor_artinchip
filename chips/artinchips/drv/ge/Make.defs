ifeq ($(CONFIG_AIC_GE_DRV),y)

GE_DRV_PATH=drv/ge

DEPPATH+=--dep-path $(GE_DRV_PATH)
VPATH+=:chip/$(GE_DRV_PATH)

ARCH_GE_DRV_SRC_PATH:=$(AIC_SRCDIR)/$(GE_DRV_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_GE_DRV_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}${INCLUDES}/include/drv

CHIP_CSRCS += $(GE_DRV_PATH)/aic_drv_ge.c

endif
